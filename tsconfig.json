{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"@agent/*": ["./apps/agent/src/*"]
		},
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["bun", "node"]
	},
	"include": ["apps/*/src", "apps/agent/scripts", "scripts"]
}
