{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"@agent/*": ["./apps/agent/agent/*"]
		},
		"lib": ["ES2024"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["bun", "node"]
	},
	"include": ["apps/*/src", "apps/agent/agent", "apps/agent/scripts", "scripts"]
}
