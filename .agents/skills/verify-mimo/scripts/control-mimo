#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
APP_DIR="$REPO_DIR/apps/desktop"
VERIFY_DIR="$REPO_DIR/.verify"
CURRENT_RUN_FILE="$VERIFY_DIR/current"
ELECTRON_VITE="$REPO_DIR/node_modules/.bin/electron-vite"
LAUNCH_TIMEOUT_SECONDS="${MIMO_VERIFY_LAUNCH_TIMEOUT:-90}"
WAIT_DEFAULT_SECONDS=180
SEND_BUSY_GRACE_SECONDS=8
SEND_DEFAULT_SECONDS=300
STOP_GRACE_SECONDS=10
PORT_FIRST=9340
PORT_LAST=9399
AUTH_PATHS=(".codex/auth.json" ".local/share/opencode/auth.json")
ENV_PATH=".mimo/.env"
CODEX_CACHE_PATH=".codex/models_cache.json"
MAIN_SOURCES=("apps/desktop/src/main" "apps/desktop/src/preload" "apps/desktop/electron.vite.config.ts" "apps/agent/src")

usage() {
	cat <<'EOF'
uso: control-mimo <comando> [argumentos]

comandos:
  launch [--data <dir>]      sobe o app desktop com CDP; dados e HOME em sandbox por padrão
  db <sql>                   consulta SQLite em modo somente leitura
  doctor                     checagem somente leitura da instância
  data | home | port | log   imprime o diretório de dados, o HOME, a porta CDP ou o log do app
  state                      imprime o estado do bot aberto: parado, trabalhando, esperando aprovação, falhou
  send [--no-wait] <texto>   escreve no campo Mensagem, envia e espera o turno terminar
  wait <regex> [seg]         espera o padrão aparecer na árvore de acessibilidade (padrão 180 s)
  capture <nome>             salva <nome>.png e <nome>.aria.txt no run dir
  browser <args...>          repassa para o agent-browser já ligado a esta instância
  stop                       encerra o que o launch iniciou; a evidência fica
EOF
}

current_run_dir() {
	if [ -f "$CURRENT_RUN_FILE" ]; then
		cat "$CURRENT_RUN_FILE"
	fi
}

run_dir_or_die() {
	local run_dir
	run_dir="$(current_run_dir)"
	if [ -z "$run_dir" ] || [ ! -d "$run_dir" ]; then
		echo "nenhuma execução registrada; rode: $0 launch" >&2
		exit 1
	fi
	printf '%s' "$run_dir"
}

resolve_path() {
	case "$1" in
	/*) printf '%s' "$1" ;;
	*) printf '%s/%s' "$REPO_DIR" "$1" ;;
	esac
}

run_value() {
	local run_dir="$1"
	local name="$2"
	if [ -n "$run_dir" ] && [ -f "$run_dir/$name.txt" ]; then
		cat "$run_dir/$name.txt"
	fi
}

app_up() {
	local run_dir="$1"
	local pid data_dir
	pid="$(run_value "$run_dir" pid)"
	data_dir="$(run_value "$run_dir" data-dir)"
	[ -n "$pid" ] || return 1
	[ -r "/proc/$pid/environ" ] || return 1
	tr '\0' '\n' <"/proc/$pid/environ" | grep -qxF "MIMO_DATA_DIR=$data_dir"
}

free_port() {
	local port
	for port in $(seq "$PORT_FIRST" "$PORT_LAST"); do
		if ! (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
			printf '%s' "$port"
			return 0
		fi
	done
	echo "nenhuma porta livre entre $PORT_FIRST e $PORT_LAST" >&2
	return 1
}

prepare_home() {
	local home_dir="$1/home"
	local relative
	mkdir -p "$home_dir/.config"
	for relative in "${AUTH_PATHS[@]}"; do
		mkdir -p "$home_dir/$(dirname "$relative")"
		if [ -f "$HOME/$relative" ] && [ ! -e "$home_dir/$relative" ]; then
			ln -s "$HOME/$relative" "$home_dir/$relative"
		fi
	done
	if [ -f "$HOME/$ENV_PATH" ]; then
		mkdir -p "$home_dir/$(dirname "$ENV_PATH")"
		ln -s "$HOME/$ENV_PATH" "$home_dir/$ENV_PATH"
	fi
	if [ -f "$HOME/$CODEX_CACHE_PATH" ]; then
		ln -s "$HOME/$CODEX_CACHE_PATH" "$home_dir/$CODEX_CACHE_PATH"
	fi
	printf '%s' "$home_dir"
}

report_auth_writes() {
	local home_dir="$1"
	[ -n "$home_dir" ] && [ -d "$home_dir" ] || return 0
	local relative wrote=0
	for relative in "${AUTH_PATHS[@]}"; do
		if [ -f "$home_dir/$relative" ] && [ ! -L "$home_dir/$relative" ]; then
			echo "atenção: esta execução escreveu credencial em $relative; ficou só na sandbox"
			wrote=1
		fi
	done
	if [ "$wrote" -eq 0 ]; then
		echo "credenciais reais intactas (só leitura por symlink)"
	fi
}

browser() {
	local run_dir
	run_dir="$(run_dir_or_die)"
	agent-browser --session "$(run_value "$run_dir" session)" --cdp "$(run_value "$run_dir" port)" "$@"
}

tree() {
	browser snapshot 2>/dev/null || true
}

bot_state() {
	tree | grep -oE 'heading "[^"]*, (parado|trabalhando|esperando aprovação|falhou)"' | head -n1 | sed -E 's/^.*, ([^"]+)"$/\1/' || true
}

wait_for() {
	local pattern="${1:-}"
	local timeout="${2:-$WAIT_DEFAULT_SECONDS}"
	if [ -z "$pattern" ]; then
		echo "uso: $0 wait <regex> [seg]" >&2
		exit 1
	fi
	local run_dir deadline
	run_dir="$(run_dir_or_die)"
	deadline=$((SECONDS + timeout))
	while [ "$SECONDS" -le "$deadline" ]; do
		if ! app_up "$run_dir"; then
			echo "o app caiu durante a espera; veja: $run_dir/app.log" >&2
			return 1
		fi
		if tree | grep -Eq -- "$pattern"; then
			return 0
		fi
		sleep 1
	done
	tree >"$run_dir/last-timeout.aria.txt"
	echo "timeout (${timeout}s) esperando por: $pattern" >&2
	echo "última árvore salva em $run_dir/last-timeout.aria.txt" >&2
	return 1
}

launch() {
	local data_override="${1:-}"
	local previous
	previous="$(current_run_dir)"
	if [ -n "$previous" ] && app_up "$previous"; then
		echo "já existe uma instância desta verificação no ar; rode: $0 stop" >&2
		exit 1
	fi
	if [ ! -x "$ELECTRON_VITE" ]; then
		echo "electron-vite ausente; rode: bun install" >&2
		exit 1
	fi
	local stamp run_dir data_dir home_dir port
	stamp="$(date -u +%Y%m%dT%H%M%SZ)"
	run_dir="$VERIFY_DIR/runs/$stamp"
	mkdir -p "$run_dir"
	data_dir="$run_dir/data"
	if [ -n "$data_override" ]; then
		data_dir="$(resolve_path "$data_override")"
	fi
	if [ "$data_dir" = "$HOME/.mimo" ]; then
		echo "recusado: $data_dir são os dados reais" >&2
		exit 1
	fi
	mkdir -p "$data_dir"
	home_dir="$(prepare_home "$run_dir")"
	port="$(free_port)"
	printf '%s' "$data_dir" >"$run_dir/data-dir.txt"
	printf '%s' "$port" >"$run_dir/port.txt"
	printf 'mimo-verify-%s' "$stamp" >"$run_dir/session.txt"
	git -C "$REPO_DIR" rev-parse HEAD >"$run_dir/head.txt"
	date -u +"%Y-%m-%dT%H:%M:%SZ" >"$run_dir/started.txt"
	printf '%s' "$run_dir" >"$CURRENT_RUN_FILE"
	(
		cd "$APP_DIR"
		exec setsid env "MIMO_DATA_DIR=$data_dir" "HOME=$home_dir" "XDG_CONFIG_HOME=$home_dir/.config" "REMOTE_DEBUGGING_PORT=$port" "$ELECTRON_VITE" dev
	) >"$run_dir/app.log" 2>&1 &
	printf '%s' "$!" >"$run_dir/pid.txt"
	local deadline=$((SECONDS + LAUNCH_TIMEOUT_SECONDS))
	while [ "$SECONDS" -le "$deadline" ]; do
		if grep -q "DevTools listening" "$run_dir/app.log" && tree | grep -q 'complementary "Bots"'; then
			echo "run dir: $run_dir"
			echo "dados: $data_dir"
			echo "home: $home_dir"
			echo "cdp: $port"
			echo "pronto."
			return 0
		fi
		if ! app_up "$run_dir"; then
			break
		fi
		sleep 1
	done
	echo "o app não ficou pronto em ${LAUNCH_TIMEOUT_SECONDS}s; fim do log:" >&2
	tail -n 20 "$run_dir/app.log" >&2
	return 1
}

doctor() {
	local run_dir
	run_dir="$(current_run_dir)"
	echo "repo: $REPO_DIR"
	echo "HEAD atual: $(git -C "$REPO_DIR" rev-parse --short HEAD)"
	if [ -z "$run_dir" ]; then
		echo "run dir: nenhum (nada foi lançado)"
		return 0
	fi
	echo "HEAD do launch: $(cut -c1-7 "$run_dir/head.txt")"
	echo "run dir: $run_dir"
	echo "dados: $(run_value "$run_dir" data-dir)"
	echo "home: $run_dir/home (sandbox)"
	if app_up "$run_dir"; then
		echo "app: no ar (pid $(run_value "$run_dir" pid), iniciado por este launch)"
	else
		echo "app: ausente"
	fi
	local port
	port="$(run_value "$run_dir" port)"
	if curl -fsS --max-time 2 "http://127.0.0.1:$port/json/version" >/dev/null 2>&1; then
		echo "cdp: $port responde"
		echo "bot aberto: $(bot_state | grep . || echo "nenhum")"
	else
		echo "cdp: $port não responde"
	fi
	local stale
	stale="$(cd "$REPO_DIR" && find "${MAIN_SOURCES[@]}" -type f -newer "$run_dir/started.txt" 2>/dev/null | head -n 5)"
	if [ -n "$stale" ]; then
		echo "main: DESATUALIZADO, o processo main não recarrega; rode stop e launch. Mudou depois do launch:"
		printf '%s\n' "$stale" | sed 's/^/  /'
	else
		echo "main: igual ao do launch (o renderer recarrega sozinho)"
	fi
	local relative
	for relative in "${AUTH_PATHS[@]}"; do
		if [ -f "$HOME/$relative" ]; then
			echo "credencial: ~/$relative presente"
		else
			echo "credencial: ~/$relative ausente"
		fi
	done
	report_auth_writes "$run_dir/home"
	local data_dir
	data_dir="$(run_value "$run_dir" data-dir)"
	echo "bots: $(read_database 'select count(*) as count from bots')"
}

read_database() {
	local data_dir
	data_dir="$(run_value "$(run_dir_or_die)" data-dir)"
	python3 - "$data_dir/mimo.sqlite" "$1" <<'PYDB'
import json
import sqlite3
import sys
from pathlib import Path
with sqlite3.connect(Path(sys.argv[1]).as_uri() + "?mode=ro", uri=True) as db:
    db.row_factory = sqlite3.Row
    print(json.dumps([dict(row) for row in db.execute(sys.argv[2])], ensure_ascii=False))
PYDB
}

send_text() {
	local no_wait=0
	if [ "${1:-}" = "--no-wait" ]; then
		no_wait=1
		shift
	fi
	local text="${1:-}"
	if [ -z "$text" ]; then
		echo "uso: $0 send [--no-wait] <texto>" >&2
		exit 1
	fi
	browser fill '[aria-label="Mensagem"]' "$text" >/dev/null
	browser press Enter >/dev/null
	if [ "$no_wait" -eq 1 ]; then
		return 0
	fi
	local state saw_busy=0
	local busy_deadline=$((SECONDS + SEND_BUSY_GRACE_SECONDS))
	local deadline=$((SECONDS + SEND_DEFAULT_SECONDS))
	while [ "$SECONDS" -le "$deadline" ]; do
		state="$(bot_state)"
		if [ "$state" = "trabalhando" ]; then
			saw_busy=1
		elif [ "$saw_busy" -eq 1 ] && [ -n "$state" ]; then
			echo "estado: $state"
			return 0
		elif [ "$SECONDS" -gt "$busy_deadline" ]; then
			echo "estado: ${state:-desconhecido} (o turno não chegou a aparecer como trabalhando)"
			return 0
		fi
		sleep 1
	done
	echo "timeout (${SEND_DEFAULT_SECONDS}s) esperando o turno terminar (estado: $state)" >&2
	exit 1
}

capture() {
	local name="${1:-}"
	if [ -z "$name" ]; then
		echo "uso: $0 capture <nome>" >&2
		exit 1
	fi
	local run_dir
	run_dir="$(run_dir_or_die)"
	browser screenshot "$run_dir/$name.png" >/dev/null
	tree >"$run_dir/$name.aria.txt"
	echo "$run_dir/$name.png"
	echo "$run_dir/$name.aria.txt"
}

stop_instance() {
	local run_dir
	run_dir="$(current_run_dir)"
	if [ -z "$run_dir" ]; then
		echo "nada para parar."
		return 0
	fi
	if app_up "$run_dir"; then
		local pid waited=0
		pid="$(run_value "$run_dir" pid)"
		kill -TERM -- "-$pid" 2>/dev/null || true
		while app_up "$run_dir" && [ "$waited" -lt "$STOP_GRACE_SECONDS" ]; do
			sleep 1
			waited=$((waited + 1))
		done
		if app_up "$run_dir"; then
			kill -KILL -- "-$pid" 2>/dev/null || true
		fi
	fi
	agent-browser --session "$(run_value "$run_dir" session)" close >/dev/null 2>&1 || true
	report_auth_writes "$run_dir/home"
	rm -f "$CURRENT_RUN_FILE"
	echo "evidência em: $run_dir"
	echo "parado."
}

mkdir -p "$VERIFY_DIR"

case "${1:-}" in
launch)
	shift
	launch_data=""
	if [ "${1:-}" = "--data" ]; then
		launch_data="${2:-}"
		if [ -z "$launch_data" ]; then
			echo "--data precisa de um diretório" >&2
			exit 1
		fi
	elif [ "$#" -gt 0 ]; then
		echo "argumento desconhecido em launch: $1" >&2
		exit 1
	fi
	launch "$launch_data"
	;;
db)
	read_database "${2:?informe a consulta SQL}"
	;;
doctor)
	doctor
	;;
data)
	run_value "$(run_dir_or_die)" data-dir
	echo
	;;
home)
	echo "$(run_dir_or_die)/home"
	;;
port)
	run_value "$(run_dir_or_die)" port
	echo
	;;
log)
	echo "$(run_dir_or_die)/app.log"
	;;
state)
	bot_state
	;;
send)
	shift
	send_text "$@"
	;;
wait)
	shift
	wait_for "$@"
	;;
capture)
	shift
	capture "$@"
	;;
browser)
	shift
	browser "$@"
	;;
stop)
	stop_instance
	;;
*)
	usage
	exit 1
	;;
esac
