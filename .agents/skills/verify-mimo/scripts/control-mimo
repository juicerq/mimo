#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
VERIFY_DIR="$REPO_DIR/.verify"
CURRENT_RUN_FILE="$VERIFY_DIR/current"
SESSION="${MIMO_VERIFY_SESSION:-mimo-verify}"
REAL_DATA_DIR="$REPO_DIR/.data"
READY_PATTERN="/new <name>"
LAUNCH_TIMEOUT_SECONDS="${MIMO_VERIFY_LAUNCH_TIMEOUT:-60}"
WAIT_INTERVAL_SECONDS=2
WAIT_DEFAULT_SECONDS=180
SEND_BUSY_GRACE_SECONDS=6
SEND_ACCEPT_SECONDS=10
SEND_DEFAULT_SECONDS=300
AUTH_PATHS=(".codex/auth.json" ".local/share/opencode/auth.json")

usage() {
	cat <<'EOF'
uso: control-mimo <comando> [argumentos]

comandos:
  launch [--data <dir>]  sobe a TUI em tmux; dados e HOME em sandbox por padrão
  doctor                 checagem somente leitura da instância
  data                   imprime o diretório de dados da execução atual
  send <texto>           digita, envia e espera o turno terminar (recusa se ocupado)
  wait <regex> [seg]     espera o padrão aparecer no pane (padrão 180 s)
  capture <arquivo>      salva o pane atual no arquivo
  stop [--keep-state]    encerra e restaura o estado (ou mantém com --keep-state)
  home                   imprime o HOME de sandbox da execução atual
  restore [run-dir]      restaura o snapshot de um run (padrão: o atual)
EOF
}

session_up() {
	tmux has-session -t "$SESSION" 2>/dev/null
}

pane_text() {
	tmux capture-pane -p -J -t "$SESSION" 2>/dev/null
}

status_state() {
	local pane picker approval
	pane="$(pane_text)"
	picker="$(printf '%s' "$pane" | grep -oE 'status:[─ ]*(loading|ready|saving)' | tail -n1 | sed -E 's/^status:[─ ]*//' || true)"
	if [ -n "$picker" ]; then
		printf '%s' "$picker"
		return
	fi
	if printf '%s' "$pane" | grep -qE '(thinking|working|stopping|loading) · [0-9]+s'; then
		printf 'thinking'
		return
	fi
	approval="$(printf '%s' "$pane" | grep -oE '⏸ (approval|approved|denied)' | tail -n1 || true)"
	if [ "$approval" = "⏸ approval" ]; then
		printf 'waiting'
		return
	fi
	printf 'ready'
}

composer_line() {
	pane_text | grep "^│" | tail -n1 || true
}

current_run_dir() {
	if [ -f "$CURRENT_RUN_FILE" ]; then
		cat "$CURRENT_RUN_FILE"
	fi
}

run_dir_or_die() {
	local run_dir
	run_dir="$(current_run_dir)"
	if [ -z "$run_dir" ] || [ ! -d "$run_dir" ]; then
		echo "nenhuma execução registrada; rode: $0 launch" >&2
		exit 1
	fi
	printf '%s' "$run_dir"
}

resolve_path() {
	case "$1" in
	/*) printf '%s' "$1" ;;
	*) printf '%s/%s' "$REPO_DIR" "$1" ;;
	esac
}

data_dir_of() {
	local run_dir="$1"
	if [ -n "$run_dir" ] && [ -f "$run_dir/data-dir.txt" ]; then
		cat "$run_dir/data-dir.txt"
		return
	fi
	printf '%s' "$REAL_DATA_DIR"
}

home_dir_of() {
	local run_dir="$1"
	if [ -n "$run_dir" ] && [ -d "$run_dir/home" ]; then
		printf '%s' "$run_dir/home"
	fi
}

prepare_home() {
	local run_dir="$1"
	local home_dir="$run_dir/home"
	local relative
	for relative in "${AUTH_PATHS[@]}"; do
		mkdir -p "$home_dir/$(dirname "$relative")"
		if [ -f "$HOME/$relative" ] && [ ! -e "$home_dir/$relative" ]; then
			ln -s "$HOME/$relative" "$home_dir/$relative"
		fi
	done
	printf '%s' "$home_dir"
}

report_auth_writes() {
	local home_dir="$1"
	[ -n "$home_dir" ] || return 0
	local relative wrote=0
	for relative in "${AUTH_PATHS[@]}"; do
		if [ -f "$home_dir/$relative" ] && [ ! -L "$home_dir/$relative" ]; then
			echo "atenção: esta execução escreveu credencial em $relative; ficou só na sandbox"
			wrote=1
		fi
	done
	if [ "$wrote" -eq 0 ]; then
		echo "credenciais reais intactas (só leitura por symlink)"
	fi
}

data_dir_or_die() {
	local run_dir
	run_dir="$(run_dir_or_die)"
	data_dir_of "$run_dir"
}

wait_for() {
	local pattern="$1"
	local timeout="${2:-$WAIT_DEFAULT_SECONDS}"
	local deadline
	deadline=$((SECONDS + timeout))
	while [ "$SECONDS" -le "$deadline" ]; do
		if ! session_up; then
			echo "sessão tmux $SESSION caiu durante a espera" >&2
			return 1
		fi
		if pane_text | grep -Eq -- "$pattern"; then
			return 0
		fi
		sleep "$WAIT_INTERVAL_SECONDS"
	done
	mkdir -p "$VERIFY_DIR"
	pane_text >"$VERIFY_DIR/last-timeout.txt" || true
	echo "timeout (${timeout}s) esperando por: $pattern" >&2
	echo "último pane salvo em $VERIFY_DIR/last-timeout.txt" >&2
	return 1
}

copy_state() {
	local data_dir="$1"
	local target="$2"
	mkdir -p "$target"
	if [ -d "$data_dir/bots" ]; then
		cp -a "$data_dir/bots" "$target/bots"
	fi
	if [ -f "$data_dir/routines.json" ]; then
		cp -a "$data_dir/routines.json" "$target/routines.json"
	fi
	if [ -f "$data_dir/actions.jsonl" ]; then
		cp -a "$data_dir/actions.jsonl" "$target/actions.jsonl"
	fi
}

restore_state() {
	local run_dir="$1"
	local data_dir="$2"
	[ -n "$run_dir" ] || return 0
	copy_state "$data_dir" "$run_dir/state-after"
	mkdir -p "$data_dir"
	if [ -d "$run_dir/state-before/bots" ]; then
		rm -rf "$data_dir/bots"
		cp -a "$run_dir/state-before/bots" "$data_dir/bots"
	elif [ -d "$data_dir/bots" ]; then
		rm -rf "$data_dir/bots"
	fi
	if [ -f "$run_dir/state-before/routines.json" ]; then
		cp -a "$run_dir/state-before/routines.json" "$data_dir/routines.json"
	elif [ -f "$data_dir/routines.json" ]; then
		rm -f "$data_dir/routines.json"
	fi
	if [ -f "$run_dir/state-before/actions.jsonl" ]; then
		cp -a "$run_dir/state-before/actions.jsonl" "$data_dir/actions.jsonl"
	elif [ -f "$data_dir/actions.jsonl" ]; then
		rm -f "$data_dir/actions.jsonl"
	fi
}

launch() {
	if session_up; then
		echo "sessão tmux $SESSION já existe; rode: $0 stop" >&2
		exit 1
	fi
	local stamp="$1"
	local data_override="${2:-}"
	local run_dir="$VERIFY_DIR/runs/$stamp"
	mkdir -p "$run_dir"
	local data_dir
	if [ -n "$data_override" ]; then
		data_dir="$(resolve_path "$data_override")"
	elif [ -n "${MIMO_VERIFY_DATA_DIR:-}" ]; then
		data_dir="$(resolve_path "$MIMO_VERIFY_DATA_DIR")"
	else
		data_dir="$run_dir/data"
	fi
	mkdir -p "$data_dir"
	printf '%s' "$data_dir" >"$run_dir/data-dir.txt"
	copy_state "$data_dir" "$run_dir/state-before"
	git -C "$REPO_DIR" rev-parse HEAD >"$run_dir/head.txt"
	date -u +"%Y-%m-%dT%H:%M:%SZ" >"$run_dir/started.txt"
	printf '%s' "$run_dir" >"$CURRENT_RUN_FILE"
	local home_dir
	home_dir="$(prepare_home "$run_dir")"
	local -a runtime_env=("MIMO_DATA_DIR=$data_dir" "HOME=$home_dir")
	local setting
	for setting in MIMO_MODEL MIMO_REASONING; do
		if [ -n "${!setting:-}" ]; then
			runtime_env+=("$setting=${!setting}")
		fi
	done
	tmux new-session -d -s "$SESSION" -x 140 -y 42 -c "$REPO_DIR" env -u MIMO_MODEL -u MIMO_REASONING "${runtime_env[@]}" bun apps/mimo/src/index.ts
	if ! wait_for "$READY_PATTERN" "$LAUNCH_TIMEOUT_SECONDS"; then
		pane_text >"$run_dir/00-launch.txt" || true
		echo "a TUI não ficou pronta em ${LAUNCH_TIMEOUT_SECONDS}s" >&2
		return 1
	fi
	pane_text >"$run_dir/00-launch.txt"
	echo "run dir: $run_dir"
	echo "dados: $data_dir"
	echo "home: $home_dir"
	echo "pronto."
}

doctor() {
	local run_dir
	run_dir="$(current_run_dir)"
	echo "repo: $REPO_DIR"
	echo "HEAD atual: $(git -C "$REPO_DIR" rev-parse --short HEAD)"
	if [ -n "$run_dir" ] && [ -f "$run_dir/head.txt" ]; then
		echo "HEAD do launch: $(cut -c1-12 "$run_dir/head.txt")"
	fi
	if [ -n "$run_dir" ]; then
		echo "run dir: $run_dir"
	else
		echo "run dir: nenhum (nada foi lançado)"
	fi
	local data_dir="$REAL_DATA_DIR"
	if [ -n "$run_dir" ]; then
		data_dir="$(data_dir_of "$run_dir")"
		if [ "$data_dir" = "$REAL_DATA_DIR" ]; then
			echo "dados: $data_dir (reais)"
		else
			echo "dados: $data_dir (sandbox)"
		fi
	fi
	if session_up; then
		echo "tmux: $SESSION no ar"
		if [ "$(status_state)" = "ready" ]; then
			echo "pane: ready"
		else
			echo "pane: fora de pronto (veja: $0 capture <arquivo>)"
		fi
	else
		echo "tmux: $SESSION ausente"
	fi
	if [ -f "$HOME/.local/share/opencode/auth.json" ] && grep -q '"opencode-go"' "$HOME/.local/share/opencode/auth.json"; then
		echo "opencode-go: credencial em ~/.local/share/opencode/auth.json"
	else
		echo "opencode-go: credencial ausente"
	fi
	if [ -f "$HOME/.codex/auth.json" ]; then
		echo "openai-codex: credencial em ~/.codex/auth.json"
	else
		echo "openai-codex: credencial ausente"
	fi
	local home_dir
	home_dir="$(home_dir_of "$run_dir")"
	if [ -n "$home_dir" ]; then
		echo "home: $home_dir (sandbox)"
		report_auth_writes "$home_dir"
	else
		echo "home: $HOME (real)"
	fi
	local env_file="$REPO_DIR/.env.local"
	if [ -f "$env_file" ] && grep -q '^GMAIL_CLIENT_ID=..' "$env_file"; then
		echo "gmail: GMAIL_CLIENT_ID presente"
	else
		echo "gmail: GMAIL_CLIENT_ID ausente em $env_file"
	fi
	if [ -f "$data_dir/gmail/accounts.json" ]; then
		echo "contas conectadas: $(grep -c '"email"' "$data_dir/gmail/accounts.json")"
	else
		echo "contas conectadas: 0"
	fi
	if [ -f "$data_dir/routines.json" ]; then
		echo "rotinas: $(grep -c '"id"' "$data_dir/routines.json")"
	else
		echo "rotinas: 0"
	fi
}

send_text() {
	local text="${1:-}"
	if [ -z "$text" ]; then
		echo "uso: $0 send <texto>" >&2
		exit 1
	fi
	if ! session_up; then
		echo "sessão tmux $SESSION não existe; rode: $0 launch" >&2
		exit 1
	fi
	local state
	state="$(status_state)"
	case "$state" in
	thinking | loading | cancelling)
		echo "bot ocupado (status: $state); espere e tente de novo" >&2
		exit 1
		;;
	esac
	tmux send-keys -t "$SESSION" -l -- "$text"
	tmux send-keys -t "$SESSION" Enter
	local tail_text="$text"
	if [ "${#text}" -gt 16 ]; then
		tail_text="${text: -16}"
	fi
	local deadline=$((SECONDS + SEND_ACCEPT_SECONDS))
	local accepted=0
	local composer
	while [ "$SECONDS" -le "$deadline" ]; do
		composer="$(composer_line)"
		if ! printf '%s' "$composer" | grep -qF -- "$tail_text"; then
			accepted=1
			break
		fi
		sleep 1
	done
	if [ "$accepted" -eq 0 ]; then
		mkdir -p "$VERIFY_DIR"
		pane_text >"$VERIFY_DIR/last-send.txt" || true
		echo "o texto ficou no composer; envio não foi aceito (bot ocupado?)" >&2
		echo "pane salvo em $VERIFY_DIR/last-send.txt" >&2
		exit 1
	fi
	local saw_busy=0
	local busy_deadline=$((SECONDS + SEND_BUSY_GRACE_SECONDS))
	deadline=$((SECONDS + SEND_DEFAULT_SECONDS))
	while [ "$SECONDS" -le "$deadline" ]; do
		state="$(status_state)"
		if [ "$saw_busy" -eq 1 ]; then
			if [ "$state" != "thinking" ] && [ "$state" != "loading" ] && [ "$state" != "cancelling" ]; then
				return 0
			fi
		elif [ "$state" = "thinking" ] || [ "$state" = "loading" ] || [ "$state" = "cancelling" ]; then
			saw_busy=1
		elif [ "$SECONDS" -gt "$busy_deadline" ]; then
			return 0
		fi
		sleep 1
	done
	echo "timeout (${SEND_DEFAULT_SECONDS}s) esperando o turno terminar (status: $state)" >&2
	exit 1
}

capture_pane() {
	local file="${1:-}"
	if [ -z "$file" ]; then
		echo "uso: $0 capture <arquivo>" >&2
		exit 1
	fi
	mkdir -p "$(dirname "$file")"
	pane_text >"$file"
	echo "$file"
}

stop_instance() {
	local keep_state=0
	if [ "${1:-}" = "--keep-state" ]; then
		keep_state=1
	fi
	local run_dir
	run_dir="$(current_run_dir)"
	local data_dir="$REAL_DATA_DIR"
	if [ -n "$run_dir" ]; then
		data_dir="$(data_dir_of "$run_dir")"
	fi
	if session_up; then
		tmux send-keys -t "$SESSION" C-c
		local waited=0
		while session_up && [ "$waited" -lt 10 ]; do
			sleep 1
			waited=$((waited + 1))
		done
		if session_up; then
			tmux kill-session -t "$SESSION"
		fi
	fi
	report_auth_writes "$(home_dir_of "$run_dir")"
	if [ "$keep_state" -eq 0 ] && [ -n "$run_dir" ]; then
		restore_state "$run_dir" "$data_dir"
		echo "estado restaurado do snapshot: $run_dir/state-before"
	elif [ -n "$run_dir" ]; then
		copy_state "$data_dir" "$run_dir/state-after"
		echo "estado mantido (--keep-state); snapshot em: $run_dir/state-before"
	fi
	echo "parado."
}

restore() {
	local run_dir="${1:-}"
	if [ -z "$run_dir" ]; then
		run_dir="$(run_dir_or_die)"
	fi
	if [ ! -d "$run_dir/state-before" ]; then
		echo "sem snapshot em $run_dir/state-before" >&2
		exit 1
	fi
	restore_state "$run_dir" "$(data_dir_of "$run_dir")"
	echo "estado restaurado de: $run_dir/state-before"
}

mkdir -p "$VERIFY_DIR"

case "${1:-}" in
launch)
	shift
	launch_data=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
		--data)
			launch_data="${2:-}"
			if [ -z "$launch_data" ]; then
				echo "--data precisa de um diretório" >&2
				exit 1
			fi
			shift 2
			;;
		*)
			echo "argumento desconhecido em launch: $1" >&2
			exit 1
			;;
		esac
	done
	stamp="$(date -u +%Y%m%dT%H%M%SZ)"
	launch "$stamp" "$launch_data"
	;;
doctor)
	doctor
	;;
data)
	data_dir_or_die
	echo
	;;
home)
	home_dir_of "$(run_dir_or_die)"
	echo
	;;
send)
	shift
	send_text "$@"
	;;
wait)
	shift
	wait_for "$@"
	;;
capture)
	shift
	capture_pane "$@"
	;;
stop)
	shift
	stop_instance "${1:-}"
	;;
restore)
	shift
	restore "$@"
	;;
*)
	usage
	exit 1
	;;
esac
