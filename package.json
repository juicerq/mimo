{
	"name": "mimo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"postinstall": "bun node_modules/electron/install.js",
		"dev": "bun run --filter @mimo/desktop dev",
		"build": "bun run --filter @mimo/desktop build",
		"start": "apps/desktop/bin/mimo",
		"check": "juicerq-check",
		"check:fix": "juicerq-check --fix",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@juicerq/check": "^0.4.0",
		"@types/bun": "1.4.0",
		"@types/node": "26.4.0",
		"typescript": "7.0.2"
	}
}
