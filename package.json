{
	"name": "mimo-tui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"workspaces": ["apps/*"],
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"check": "juicerq-check",
		"check:fix": "juicerq-check --fix",
		"typecheck": "tsc --noEmit",
		"gmail:auth": "bun run --cwd apps/agent gmail:auth"
	},
	"devDependencies": {
		"@juicerq/check": "^0.4.0",
		"@types/bun": "1.4.0",
		"@types/node": "26.4.0",
		"typescript": "7.0.2"
	}
}
