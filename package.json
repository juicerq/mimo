{
  "name": "mimo",
  "version": "0.1.35",
  "private": true,
  "description": "Times de Bots que trabalham no seu computador",
  "author": "Mimo",
  "desktopName": "mimo.desktop",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "main": "out/main/index.js",
  "trustedDependencies": ["electron", "agent-browser"],
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "dev": "bun run dev:run",
    "dev:load": "MIMO_USER_DATA=$PWD/.mimo-load MIMO_LOAD_PROVIDER=true bun run dev:run",
    "dev:github-relay": "bun github-relay/index.ts",
    "dev:run": "bun run build:engine && electron-vite dev",
    "seed:load": "bun src/engine/persistence/load-seed.ts",
    "bench:open": "bun bench/conversation-open.ts",
    "bench:turn": "bun bench/conversation-turn.ts",
    "bench:boot": "bun bench/boot.ts",
    "bench:typing": "bun bench/typing.ts",
    "bench:scroll": "bun bench/scroll.ts",
    "bench:memory": "bun bench/memory.ts",
    "bench:queue": "bun bench/queue.ts",
    "bench:jev": "bun bench/jev-isolated.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "check": "juicerq-check",
    "check:fix": "juicerq-check --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests --isolate --no-orphans",
    "test:stress": "bun test ./tests --isolate --no-orphans --randomize --rerun-each 3",
    "build:engine": "bun build --compile --outfile dist-engine/mimo-engine src/engine/index.ts",
    "build:electron": "electron-vite build",
    "build:github-relay": "bun build --compile --outfile dist-relay/mimo-github-relay github-relay/index.ts",
    "build": "bun run build:engine && bun run build:electron",
    "release": "bun scripts/release.ts",
    "package:linux": "bun run build && electron-builder --linux"
  },
  "dependencies": {
    "@blobatar/react": "^2.7.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/tanstack-query": "1.15.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-store": "0.11.1",
    "@typesafe-ai/sdk": "0.6.0",
    "agent-browser": "0.36.0",
    "baileys": "^7.0.0-rc14",
    "blobatar": "^2.7.0",
    "drizzle-orm": "1.0.0-rc.4",
    "electron-updater": "^6.8.9",
    "elysia": "^1.4.30",
    "hast-util-to-jsx-runtime": "2.3.6",
    "highlight.js": "10.7.3",
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@juicerq/check": "^0.4.0",
    "@lobomfz/ghostapi": "1.0.1",
    "@tailwindcss/vite": "^4",
    "@types/bun": "1.4.0",
    "@types/hast": "3.0.5",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
